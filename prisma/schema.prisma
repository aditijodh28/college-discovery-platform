datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  image         String?
  savedColleges SavedCollege[]
}

model College {
  id        Int    @id @default(autoincrement())
  name      String
  location  String
  rating    Float
  fees      Int
  placement Int
}

model SavedCollege {
  id        String @id @default(cuid())
  collegeId Int
  userId    String
}